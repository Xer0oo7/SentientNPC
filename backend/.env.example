# ──────────────────────────────────────────────────────────────────────────────
# SentientNPC Backend — Environment Variables
# Copy this file to .env and adjust values for your environment.
# ──────────────────────────────────────────────────────────────────────────────

# ── Simulation Engine ────────────────────────────────────────────────────────
# Tick interval in milliseconds (lower = faster simulation, higher CPU)
TICK_INTERVAL_MS=200

# ── Memory Manager ───────────────────────────────────────────────────────────
# Short-term memory time-to-live in seconds before expiry
STM_TTL_SECONDS=30
# Max number of short-term memories per NPC
STM_CAPACITY=20

# ── LLM / Ollama ────────────────────────────────────────────────────────────
# Ollama API endpoint for dialogue generation
OLLAMA_URL=http://localhost:11434/api/generate
# Set to 1 to include Ollama in the /ready health check
CHECK_OLLAMA=0

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * for local development)
CORS_ORIGINS=*

# ── Python ───────────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
